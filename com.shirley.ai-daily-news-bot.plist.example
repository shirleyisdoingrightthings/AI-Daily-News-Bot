<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    配置模板：复制为 ~/Library/LaunchAgents/com.shirley.ai-daily-news-bot.plist 并填入真实值。
    claude_report.sh 通过 PlistBuddy 从 EnvironmentVariables 读取密钥与代理端口（统一为 1082）。
-->
<dict>
    <key>Label</key>
    <string>com.shirley.ai-daily-news-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/true</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FEISHU_WEBHOOK</key>
        <string>YOUR_FEISHU_WEBHOOK_URL</string>
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:1082</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:1082</string>
    </dict>
</dict>
</plist>
